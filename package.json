{
  "name": "purpleair-notify",
  "version": "1.1.0",
  "description": "Use GitHub Actions to receive an email whenever PurpleAir sensor(s) show AQI air quality PM2.5 as unhealthy.",
  "main": "dist/scrape.js",
  "scripts": {
    "scrape": "ts-node scrape.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbulnes/purpleair-notify.git"
  },
  "keywords": [
    "purpleair",
    "air-quality",
    "aqi",
    "pm25",
    "github-actions"
  ],
  "author": "David Bulnes",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dbulnes/purpleair-notify/issues"
  },
  "homepage": "https://github.com/dbulnes/purpleair-notify#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "undici": "^6.28.1"
  }
}
